# Path to your Rancher / Kubernetes Kubeconfig file
kubeconfig_path = "~/.kube/config"

# (Optional) Kubeconfig context name
# kubeconfig_context = "rancher-cluster-context"

# Kubernetes Namespace
namespace = "employee-management"

# Container Images (Replace with your container registry paths if needed)
api_image = "employee-management-api:latest"
ui_image  = "employee-management-ui:latest"

# Replica Counts
api_replicas = 2
ui_replicas  = 2

# MongoDB Atlas Connection URI (Secured via Kubernetes Secret Injection)
mongodb_uri = "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/employeedb?retryWrites=true&w=majority"

# Ingress Settings
ingress_host       = ""
ingress_class_name = "nginx"
